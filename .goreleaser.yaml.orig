version: 2
project_name: gocdm
builds:
  - id: gocdm
    main: ./cmd/gocdm
    binary: gocdm
    env:
      - CGO_ENABLED=1
    goos:
      - linux
    goarch:
      - amd64
      - arm64
    ldflags:
    ldflags: &common-ldflags
      - -s
      - -w
      - -X github.com/arran4/gocdm/cli.Version={{.Version}}
    overrides:
      - goos: linux
        goarch: arm64
        env:
          - CC=aarch64-linux-gnu-gcc
          - CGO_ENABLED=1

  - id: gocdm-nopam
    main: ./cmd/gocdm
    binary: gocdm-nopam
    flags:
      - -tags=nopam
    env:
      - CGO_ENABLED=0
    goos:
      - linux
    goarch:
      - amd64
      - arm64
    ldflags:
    ldflags: *common-ldflags
archives:
  - id: gocdm
    files:
      - license.txt
      - README.md
      - profile.sh
      - src: themes
        dst: themes
    ids:
      - gocdm
    formats:
      - tar.gz
nfpms:
  - id: gocdm
    formats:
      - deb
      - rpm
      - apk
    vendor: gocdm
    homepage: https://github.com/arran4/gocdm
    maintainer: gocdm maintainers <example@example.com>
    description: gocdm is a console display manager
    license: MIT
    bindir: /usr/local/bin
    ids:
      - gocdm
  - id: gocdm-nopam
    package_name: gocdm-nopam
    formats:
      - deb
      - rpm
      - apk
    vendor: gocdm
    homepage: https://github.com/arran4/gocdm
    maintainer: gocdm maintainers <example@example.com>
    description: gocdm is a console display manager (without pam support)
    license: MIT
    bindir: /usr/local/bin
    ids:
      - gocdm-nopam
checksum:
  name_template: checksums.txt
release:
  mode: replace
snapshot:
  version_template: '{{ .Tag }}-next'
changelog:
  sort: asc
  filters:
    exclude:
      - '^docs:'
      - '^test:'
